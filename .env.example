# ZaZa central server — example configuration. PLACEHOLDERS ONLY.
#
# Copy to a private location (never commit the real file; `.env` and
# `.env.*` are git-ignored except this example) and set real values there,
# or set these as Windows service / system environment variables.

# Repository backend: sqlite (local development) or postgres (production)
ZAZA_SERVER_BACKEND=postgres

# Either one URL (percent-encode special characters in the password) ...
# ZAZA_DATABASE_URL=postgresql://zaza_app:CHANGE_ME@127.0.0.1:5432/zaza

# ... or separate parts (these override the URL parts when both are set)
ZAZA_DB_HOST=127.0.0.1
ZAZA_DB_PORT=5432
ZAZA_DB_NAME=zaza
ZAZA_DB_USER=zaza_app
# Prefer a password file readable only by the service account:
ZAZA_DB_PASSWORD_FILE=C:\ProgramData\ZaZa\db_password.txt
# or (less preferred) the password itself:
ZAZA_DB_PASSWORD=
ZAZA_DB_SSLMODE=prefer
# Optional dedicated schema (default: public)
# ZAZA_DB_SCHEMA=zaza

# Connection pool — keep small on the VPS
ZAZA_DB_POOL_MIN=1
ZAZA_DB_POOL_MAX=4
ZAZA_DB_POOL_TIMEOUT=10
ZAZA_DB_CONNECT_TIMEOUT=5
ZAZA_DB_STATEMENT_TIMEOUT_MS=15000

# ─── Attendance calculation policy (Phase 5; optional) ──────────────────────
# Leave empty for the defaults shown. Global for all employees; every summary
# row records the policy it used. Recalculate affected dates after changing.
# Lateness / early leave up to this many seconds is ignored (default 0).
ZAZA_ATTENDANCE_LATE_GRACE_SECONDS=
ZAZA_ATTENDANCE_EARLY_LEAVE_GRACE_SECONDS=
# Minimum ACTIVE seconds before / after the shift to count as overtime (default 0).
ZAZA_ATTENDANCE_OVERTIME_MIN_SECONDS=
# ACTIVE time before the shift counts as overtime: true/false (default true).
ZAZA_ATTENDANCE_COUNT_PRE_SHIFT_OVERTIME=
# Activity within this many seconds of a shift belongs to that shift's date
# (default 14400 = 4 h; 0..43200).
ZAZA_ATTENDANCE_ATTRIBUTION_MARGIN_SECONDS=
# Minimum IDLE/LOCKED run for "Detected Break / Idle" (default 900 = 15 min).
ZAZA_ATTENDANCE_BREAK_MIN_SECONDS=
# UNKNOWN share of a shift at which "absent" can't be concluded (default 0.5; >0 and <=1).
ZAZA_ATTENDANCE_INCOMPLETE_UNKNOWN_RATIO=

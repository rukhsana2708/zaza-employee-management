# ZaZa central server — production configuration (Phase 10). NO SECRETS HERE.
#
# Installed by Install-ZaZaConfig.ps1 as
#   C:\apps\ZaZaEmployeeManagement\config\zaza-server.env
# and read by `python -m deskmate.zaza_server --env-file <that file> ...`
# (the Windows service and the scheduled jobs use the same file).
#
# Only ZAZA_* keys are read. An empty value means "use the default".
# Passwords are read from files in C:\apps\ZaZaEmployeeManagement\secrets,
# never from this file. Values marked <PENDING> are filled in during
# Phase 10C; until then `check-config --production` reports them.

ZAZA_SERVER_BACKEND=postgres

# ─── PostgreSQL 18 on this server (127.0.0.1:5432) ──────────────────────────
ZAZA_DB_HOST=127.0.0.1
ZAZA_DB_PORT=5432
ZAZA_DB_NAME=zaza_employee_management
# The API and the attendance job use the least-privileged application role.
# (Migrations use zaza_employee_owner; the Sheets job zaza_employee_report —
# their scripts override ZAZA_DB_USER / ZAZA_DB_PASSWORD_FILE per command.)
ZAZA_DB_USER=zaza_employee_app
ZAZA_DB_PASSWORD_FILE=C:\apps\ZaZaEmployeeManagement\secrets\db-app.password
# Local TCP to 127.0.0.1; the existing pg_hba.conf is not changed.
ZAZA_DB_SSLMODE=prefer
# Small pool: the server has ~6 GB RAM shared with ZazaVoice and PostgreSQL.
ZAZA_DB_POOL_MIN=1
ZAZA_DB_POOL_MAX=3
ZAZA_DB_POOL_TIMEOUT=10
ZAZA_DB_CONNECT_TIMEOUT=5
ZAZA_DB_STATEMENT_TIMEOUT_MS=15000

# ─── HTTP: behind Caddy on this server ──────────────────────────────────────
# Public host name(s) Caddy serves for ZaZa: no scheme, no port. <PENDING>
ZAZA_PUBLIC_HOST=
# Forwarded headers are trusted only from the local reverse proxy.
ZAZA_TRUSTED_PROXY_IPS=127.0.0.1,::1

# ─── Manager dashboard ──────────────────────────────────────────────────────
ZAZA_DASHBOARD_COOKIE_SECURE=true
ZAZA_DASHBOARD_SESSION_HOURS=12
ZAZA_DASHBOARD_LOGIN_MAX_FAILURES_PER_CLIENT=10
ZAZA_DASHBOARD_LOGIN_MAX_FAILURES_PER_USERNAME=20
ZAZA_DASHBOARD_LOGIN_WINDOW_SECONDS=900

# ─── Logging (bounded: 10 MiB x (1 + 5) = 60 MiB at most) ──────────────────
ZAZA_LOG_FILE=C:\apps\ZaZaEmployeeManagement\logs\zaza-server.log
ZAZA_LOG_LEVEL=INFO
ZAZA_LOG_MAX_BYTES=10485760
ZAZA_LOG_BACKUP_COUNT=5

# ─── Google Sheets (Phase 10C; NOT configured yet) ──────────────────────────
# ZAZA_GOOGLE_SHEET_ID=<PENDING>
# ZAZA_GOOGLE_SERVICE_ACCOUNT_FILE=C:\apps\ZaZaEmployeeManagement\secrets\google-service-account.json
ZAZA_SHEETS_ACTIVITY_DAYS=30
ZAZA_SHEETS_SUMMARY_MONTHS=12
ZAZA_GOOGLE_API_TIMEOUT_SECONDS=30
